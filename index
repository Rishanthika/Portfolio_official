
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rishanthika S — AI/ML Engineer & Software Developer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0a0a0a;--paper:#f5f2eb;--cream:#ede9df;
  --accent:#c4451a;--accent2:#1a4fc4;--muted:#6b6760;
  --border:rgba(10,10,10,0.12);--card-bg:rgba(255,255,255,0.7);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;scroll-snap-type:y mandatory;}
body{font-family:'Syne',sans-serif;background:var(--paper);color:var(--ink);overflow-x:hidden;cursor:none;}

/* Cursor */
.cursor{position:fixed;width:8px;height:8px;background:var(--accent);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform .15s,background .2s;}
.cursor-ring{position:fixed;width:32px;height:32px;border:1.5px solid var(--accent);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);opacity:.5;}

/* Nav */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;justify-content:space-between;align-items:center;padding:1.1rem 3.5rem;backdrop-filter:blur(16px);background:rgba(245,242,235,.92);border-bottom:1px solid var(--border);}
.nav-logo{font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);}
.nav-links{display:flex;gap:2rem;list-style:none;}
.nav-links a{font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.12em;text-decoration:none;color:var(--muted);text-transform:uppercase;transition:color .2s;cursor:none;}
.nav-links a:hover{color:var(--accent);}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:none;padding:4px;}
.hamburger span{width:22px;height:1.5px;background:var(--ink);display:block;transition:all .3s;}
.mob-menu{display:none;position:fixed;top:57px;left:0;right:0;background:rgba(245,242,235,.98);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);z-index:499;padding:1.5rem 2rem;flex-direction:column;gap:1rem;}
.mob-menu.open{display:flex;}
.mob-menu a{font-family:'DM Mono',monospace;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:var(--muted);padding:.4rem 0;border-bottom:1px solid var(--border);}
.mob-menu a:hover{color:var(--accent);}

/* Hero */
.hero{min-height:100vh;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;padding:9rem 3.5rem 5rem;position:relative;overflow:hidden;gap:4rem;}
.hero-bg-text{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:clamp(100px,17vw,200px);font-weight:800;letter-spacing:-.05em;color:transparent;-webkit-text-stroke:1px rgba(10,10,10,.055);white-space:nowrap;pointer-events:none;user-select:none;}
.hero-left{position:relative;z-index:2;}
.hero-tag{display:inline-block;font-family:'DM Mono',monospace;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);border:1px solid var(--accent);padding:.32rem .8rem;margin-bottom:1.8rem;animation:fadeUp .7s ease both;}
.hero-name{font-size:clamp(2.8rem,5.5vw,5.2rem);font-weight:800;line-height:.95;letter-spacing:-.04em;margin-bottom:1.4rem;animation:fadeUp .7s .1s ease both;}
.hero-name span{color:var(--accent);font-style:italic;font-family:'Instrument Serif',serif;}
.hero-desc{font-size:1rem;line-height:1.75;color:var(--muted);max-width:460px;margin-bottom:2.2rem;animation:fadeUp .7s .2s ease both;}
.hero-cta{display:flex;gap:1rem;flex-wrap:wrap;animation:fadeUp .7s .3s ease both;}
.btn-primary{display:inline-flex;align-items:center;gap:.5rem;background:var(--ink);color:var(--paper);padding:.8rem 1.8rem;font-family:'Syne',sans-serif;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;transition:background .25s,transform .25s;cursor:none;}
.btn-primary:hover{background:var(--accent);transform:translateY(-2px);}
.btn-outline{display:inline-flex;align-items:center;gap:.5rem;border:1.5px solid var(--ink);color:var(--ink);padding:.8rem 1.8rem;font-family:'Syne',sans-serif;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-decoration:none;text-transform:uppercase;transition:border-color .25s,color .25s,transform .25s;cursor:none;}
.btn-outline:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px);}
.hero-right{position:relative;z-index:2;display:flex;flex-direction:column;gap:.9rem;animation:fadeUp .7s .35s ease both;}
.stat-card{background:var(--card-bg);border:1px solid var(--border);padding:1.1rem 1.4rem;backdrop-filter:blur(8px);display:flex;align-items:baseline;gap:1rem;}
.stat-num{font-size:2.3rem;font-weight:800;letter-spacing:-.04em;color:var(--accent);line-height:1;flex-shrink:0;}
.stat-label{font-size:.78rem;color:var(--muted);line-height:1.45;}
.scroll-ind{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);animation:scrollB 2.5s infinite;}
.scroll-ind::after{content:'';width:1px;height:36px;background:var(--muted);}

/* Sections */
section{padding:5.5rem 3.5rem;position:relative;min-height:100vh;scroll-snap-align:start;scroll-snap-stop:always;display:flex;flex-direction:column;justify-content:center;}
.section-label{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.28em;text-transform:uppercase;color:var(--accent);margin-bottom:.65rem;display:flex;align-items:center;gap:.8rem;}
.section-label::before{content:'';display:block;width:28px;height:1px;background:var(--accent);}
.section-title{font-size:clamp(2rem,4vw,3.2rem);font-weight:800;letter-spacing:-.04em;line-height:1;margin-bottom:2.8rem;}

/* About */
.about-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:5rem;align-items:start;}
.about-text{font-family:'Instrument Serif',serif;font-size:1.45rem;line-height:1.65;color:var(--ink);}
.about-text em{color:var(--accent);font-style:italic;}
.about-sub{font-size:.97rem;font-family:'Syne',sans-serif;color:var(--muted);line-height:1.75;margin-top:1.8rem;}
.about-meta{display:flex;flex-direction:column;gap:1.3rem;padding-top:.25rem;}
.meta-item{border-top:1px solid var(--border);padding-top:1rem;}
.meta-key{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-bottom:.38rem;}
.meta-val{font-size:.92rem;font-weight:600;line-height:1.4;}
.meta-sub-text{font-size:.78rem;color:var(--muted);margin-top:.18rem;}
.meta-links{display:flex;gap:.65rem;flex-wrap:wrap;margin-top:.45rem;}
.meta-link{font-family:'DM Mono',monospace;font-size:.67rem;letter-spacing:.08em;text-decoration:none;border:1px solid;padding:.28rem .65rem;transition:opacity .2s;cursor:none;}
.meta-link:hover{opacity:.7;}

/* Skills */
.skills-section{background:var(--ink);color:var(--paper);}
.skills-section .section-label{color:#e05a30;}
.skills-section .section-label::before{background:#e05a30;}
.skills-section .section-title{color:var(--paper);}
.skills-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.09);}
.skill-block{background:var(--ink);padding:2rem;transition:background .2s;}
.skill-block:hover{background:#161616;}
.skill-icon{font-size:1.3rem;margin-bottom:.9rem;opacity:.8;}
.skill-cat{font-size:.8rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;margin-bottom:.8rem;}
.skill-tags{display:flex;flex-wrap:wrap;gap:.4rem;}
.skill-tag{font-family:'DM Mono',monospace;font-size:.62rem;padding:.22rem .58rem;border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.58);letter-spacing:.05em;transition:all .2s;}
.skill-tag:hover{border-color:#e05a30;color:#e05a30;}

/* Software Engineering section */
.se-section{background:var(--cream);}
.se-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start;}
.se-left{}
.se-intro{font-family:'Instrument Serif',serif;font-size:1.3rem;line-height:1.65;color:var(--ink);margin-bottom:1.6rem;}
.se-intro em{color:var(--accent);font-style:italic;}
.se-pillars{display:flex;flex-direction:column;gap:1rem;}
.pillar{background:var(--card-bg);border:1px solid var(--border);padding:1.2rem 1.4rem;transition:border-color .2s,transform .2s;}
.pillar:hover{border-color:var(--accent);transform:translateX(4px);}
.pillar-title{font-size:.82rem;font-weight:700;letter-spacing:.04em;margin-bottom:.35rem;display:flex;align-items:center;gap:.6rem;}
.pillar-icon{color:var(--accent);font-size:.9rem;}
.pillar-desc{font-size:.78rem;color:var(--muted);line-height:1.6;}
.se-right{display:flex;flex-direction:column;gap:1.4rem;}
.se-stack-block{border:1px solid var(--border);overflow:hidden;}
.se-stack-head{background:var(--ink);color:var(--paper);padding:.7rem 1.2rem;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;}
.se-stack-body{padding:1rem 1.2rem;display:flex;flex-wrap:wrap;gap:.4rem;background:white;}
.se-tag{font-family:'DM Mono',monospace;font-size:.62rem;padding:.22rem .55rem;border:1px solid var(--border);color:var(--muted);background:var(--paper);transition:all .2s;}
.se-tag:hover{border-color:var(--accent2);color:var(--accent2);}
.se-principles{margin-top:1.4rem;border:1px solid var(--border);overflow:hidden;}
.se-principles-head{background:var(--accent);color:white;padding:.7rem 1.2rem;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;}
.se-principles-body{padding:1rem 1.2rem;display:flex;flex-direction:column;gap:.5rem;background:white;}
.principle-item{font-size:.78rem;color:var(--muted);display:flex;align-items:flex-start;gap:.6rem;line-height:1.5;}
.principle-item::before{content:'→';color:var(--accent);flex-shrink:0;font-family:'DM Mono',monospace;font-size:.7rem;margin-top:.05rem;}

/* Research Banner */
.research-banner{background:var(--accent);color:white;padding:4rem 3.5rem;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;}
.research-banner h2{font-size:2.3rem;font-weight:800;letter-spacing:-.04em;line-height:1.05;}
.research-banner p{font-size:.97rem;line-height:1.7;opacity:.86;margin-top:1rem;}
.research-note{font-family:'DM Mono',monospace;font-size:.68rem;opacity:.7;margin-top:.8rem;letter-spacing:.05em;font-style:italic;}
.research-stats{display:flex;gap:2.5rem;flex-wrap:wrap;}
.r-stat{border-left:2px solid rgba(255,255,255,.28);padding-left:1.4rem;}
.r-stat-num{font-size:2.8rem;font-weight:800;letter-spacing:-.05em;line-height:1;}
.r-stat-label{font-size:.68rem;opacity:.72;margin-top:.28rem;font-family:'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;}

/* Experience */
.experience-section{background:var(--cream);}
.exp-card{background:var(--card-bg);border:1px solid var(--border);padding:2.2rem 2.4rem;backdrop-filter:blur(8px);transition:border-color .2s,transform .2s;}
.exp-card:hover{border-color:var(--accent);transform:translateY(-3px);}
.exp-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1.5rem;flex-wrap:wrap;margin-bottom:1.1rem;}
.exp-role{font-size:1.25rem;font-weight:700;letter-spacing:-.02em;margin-bottom:.3rem;}
.exp-company{font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.1em;color:var(--accent);text-transform:uppercase;}
.exp-meta{display:flex;flex-direction:column;align-items:flex-end;gap:.3rem;}
.exp-duration{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.08em;color:var(--muted);text-transform:uppercase;}
.exp-link{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.05em;text-decoration:none;border:1px solid var(--border);padding:.28rem .65rem;color:var(--muted);transition:all .2s;cursor:none;}
.exp-link:hover{border-color:var(--accent);color:var(--accent);}
.exp-points{display:flex;flex-direction:column;gap:.65rem;margin-top:.4rem;}
.exp-point{font-size:.85rem;color:var(--muted);line-height:1.6;display:flex;align-items:flex-start;gap:.65rem;}
.exp-point::before{content:'→';color:var(--accent);flex-shrink:0;font-family:'DM Mono',monospace;font-size:.75rem;margin-top:.1rem;}

/* Projects */
.projects-grid{display:flex;flex-direction:column;border:1px solid var(--border);overflow:hidden;}
.project-row{background:var(--paper);display:grid;grid-template-columns:56px 1fr 220px;align-items:center;padding:1.7rem 2rem;gap:2rem;transition:background .18s;cursor:none;text-decoration:none;color:inherit;border-bottom:1px solid var(--border);}
.project-row:last-child{border-bottom:none;}
.project-row:hover{background:var(--cream);}
.project-row:hover .proj-arrow{transform:translateX(5px);}
.proj-num{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted);letter-spacing:.1em;}
.proj-main{display:flex;flex-direction:column;gap:.38rem;min-width:0;}
.proj-title{font-size:1.08rem;font-weight:700;letter-spacing:-.02em;}
.proj-badges{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;}
.proj-desc{font-size:.8rem;color:var(--muted);line-height:1.55;margin-top:.25rem;}
.proj-tag{font-family:'DM Mono',monospace;font-size:.6rem;padding:.18rem .5rem;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;}
.tag-research{background:#fef3ed;color:#c4451a;border:1px solid #f4c4b3;}
.tag-ai{background:#edf1fe;color:#1a4fc4;border:1px solid #b5d4f4;}
.tag-system{background:#edf7ed;color:#2d7a2d;border:1px solid #c0dd97;}
.tag-cv{background:#f5edf9;color:#7a2da0;border:1px solid #d4a0e8;}
.tag-health{background:#fef5ed;color:#a05a1a;border:1px solid #f4d0b3;}
.tag-se{background:#f0f4ff;color:#1a4fc4;border:1px solid #c0d0f4;}
.proj-right-col{display:flex;flex-direction:column;align-items:flex-end;gap:.45rem;}
.proj-metric{font-family:'DM Mono',monospace;font-size:.7rem;color:var(--accent);font-weight:500;text-align:right;line-height:1.5;}
.proj-arrow{font-size:1.1rem;color:var(--muted);transition:transform .2s;}

/* Pubs strip */
.pubs-strip{background:var(--cream);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:3rem 3.5rem;display:flex;align-items:center;gap:4rem;flex-wrap:wrap;}
.pubs-label{font-family:'DM Mono',monospace;font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);flex-shrink:0;}
.pubs-count{font-size:2.5rem;font-weight:800;letter-spacing:-.05em;color:var(--ink);flex-shrink:0;}
.pubs-text{font-size:.9rem;color:var(--muted);line-height:1.65;max-width:620px;}
.pubs-text strong{color:var(--ink);}

/* Certs */
.certs-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
.cert-card{background:var(--card-bg);border:1px solid var(--border);padding:1.5rem 1.4rem;backdrop-filter:blur(8px);transition:transform .2s,border-color .2s;display:flex;flex-direction:column;gap:.35rem;}
.cert-card:hover{transform:translateY(-4px);border-color:var(--accent);}
.cert-issuer{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);}
.cert-name{font-size:.88rem;font-weight:700;line-height:1.35;}
.cert-detail{font-size:.76rem;color:var(--muted);line-height:1.5;}
.cert-skills{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.3rem;}
.cert-skill{font-family:'DM Mono',monospace;font-size:.58rem;padding:.15rem .45rem;background:var(--cream);color:var(--muted);border:1px solid var(--border);}
.cert-footer{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:.6rem;border-top:1px solid var(--border);}
.cert-date{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--muted);}
.cert-badge{font-family:'DM Mono',monospace;font-size:.58rem;padding:.15rem .45rem;background:#fef3ed;color:var(--accent);border:1px solid #f4c4b3;}

/* Contact */
.contact-section{background:var(--ink);color:var(--paper);padding:6rem 3.5rem;text-align:center;}
.contact-section .section-label{color:#e05a30;justify-content:center;}
.contact-section .section-label::before{background:#e05a30;}
.contact-tagline{font-family:'Instrument Serif',serif;font-size:clamp(1.8rem,4.5vw,3.5rem);line-height:1.2;max-width:680px;margin:0 auto 2.8rem;font-style:italic;}
.contact-links{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;}
.contact-link{display:inline-flex;align-items:center;gap:.5rem;color:var(--paper);text-decoration:none;font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;border:1px solid rgba(255,255,255,.18);padding:.72rem 1.4rem;transition:all .2s;cursor:none;}
.contact-link:hover{border-color:#e05a30;color:#e05a30;transform:translateY(-2px);}

footer{background:var(--ink);color:rgba(255,255,255,.28);text-align:center;padding:1.4rem;font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.16em;border-top:1px solid rgba(255,255,255,.07);}
hr.rule{border:none;border-top:1px solid var(--border);}

/* Reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease;}
.reveal.visible{opacity:1;transform:none;}
.d1{transition-delay:.1s;}.d2{transition-delay:.2s;}.d3{transition-delay:.3s;}

@keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:translateY(0);}}
@keyframes scrollB{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(7px);}}

@media(max-width:960px){
  nav{padding:1rem 1.5rem;}
  .nav-links{display:none;}
  .hamburger{display:flex;}
  .hero{grid-template-columns:1fr;padding:7.5rem 1.5rem 4rem;gap:2.5rem;}
  .about-grid{grid-template-columns:1fr;gap:2.5rem;}
  .skills-grid{grid-template-columns:1fr 1fr;}
  .certs-grid{grid-template-columns:1fr 1fr;}
  section{padding:4rem 1.5rem;}
  .project-row{grid-template-columns:44px 1fr;}
  .proj-right-col{display:none;}
  .research-banner{grid-template-columns:1fr;gap:2rem;padding:3rem 1.5rem;}
  .pubs-strip{gap:1.5rem;padding:2rem 1.5rem;}
  .se-grid{grid-template-columns:1fr;}
}
@media(max-width:600px){
  .skills-grid{grid-template-columns:1fr;}
  .certs-grid{grid-template-columns:1fr;}
  .hero-cta{flex-direction:column;align-items:flex-start;}
  .contact-links{flex-direction:column;align-items:center;}
}
</style>
</head>
